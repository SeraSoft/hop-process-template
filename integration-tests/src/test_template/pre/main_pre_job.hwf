<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>Pre main job</name>
  <name_sync_with_filename>N</name_sync_with_filename>
  <description/>
  <extended_description/>
  <workflow_version/>
  <workflow_status>0</workflow_status>
  <created_user>-</created_user>
  <created_date>2011/11/28 16:06:38.743</created_date>
  <modified_user>-</modified_user>
  <modified_date>2011/11/28 16:06:38.743</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>96</xloc>
      <yloc>200</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Interrompi job</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>861</xloc>
      <yloc>608</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Successo</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1626</xloc>
      <yloc>608</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Check process exists</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>(?!$|\s+).*</comparevalue>
      <fieldtype>string</fieldtype>
      <successbooleancondition>false</successbooleancondition>
      <successcondition>regexp</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>${p_base_process_name}</variablename>
      <parallel>N</parallel>
      <xloc>946</xloc>
      <yloc>200</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log Info 2</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <loglevel>Basic</loglevel>
      <logmessage>BASE PROCESS NAME NOT SET. EXIT!</logmessage>
      <logsubject/>
      <parallel>N</parallel>
      <xloc>903</xloc>
      <yloc>336</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>init_process_id.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/integration-tests/src/test_template/pre/init/init_process_id.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>1116</xloc>
      <yloc>200</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Dump Application Variables</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <loglevel>Basic</loglevel>
      <logmessage>
Dump Application Variables - ${p_base_process_name}
---------------------------------------------------------------------------------------

GENERIC
=======================================================================================
v_process_run_date       -> ${v_process_run_date} 
v_process_run_timestamp  -> ${v_process_run_timestamp}
v_hostname           -> ${v_hostname}
v_host_ip            -> ${v_host_ip}
serasoft.hop.user             -> ${serasoft.hop.user} 
serasoft.hop.program.name     -> ${serasoft.hop.program.name}
=======================================================================================

Delete this last message and add here your own application instance variable's dump \o/ </logmessage>
      <logsubject/>
      <parallel>N</parallel>
      <xloc>1626</xloc>
      <yloc>200</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Init Global Vars</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <fields>
        <field>
          <variable_name>v_email_feedback_enabled</variable_name>
          <variable_type>ROOT_WORKFLOW</variable_type>
          <variable_value>1</variable_value>
        </field>
      </fields>
      <file_variable_type>JVM</file_variable_type>
      <replacevars>Y</replacevars>
      <parallel>N</parallel>
      <xloc>266</xloc>
      <yloc>200</yloc>
      <attributes_hac/>
    </action>
    <action>
