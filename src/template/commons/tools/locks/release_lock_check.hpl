<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>Check process exists</name>
    <name_sync_with_filename>N</name_sync_with_filename>
    <description>Fails when no process with short_name = p_base_process_name is declared in integrations_processes (used by release_lock.hwf)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>p_base_process_name</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit/>
    <created_user>-</created_user>
    <created_date>2026/09/25 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/25 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Get process</from>
      <to>Detect empty stream</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Detect empty stream</from>
      <to>Abort if not declared</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Get process</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>${serasoft.integrations.db.connection.name}</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <lookup/>
    <sql>SELECT id
FROM ${serasoft.integrations.db.config.schema}.integrations_processes
WHERE short_name = '${p_base_process_name}'</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Detect empty stream</name>
    <type>DetectEmptyStream</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Abort if not declared</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <always_log_rows>N</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
